# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local/machine-specific state (never shared)
.claude/settings.local.json

# Ad-hoc local credential/connection-string scratch files (never commit these)
connectionstringsupabase.*
transactionpoolsupabase.*
*pg_conn*.txt
~$*

# Ingestion output: deterministically regenerated from data/ source files by
# scripts/ingestion/extract_club_directory.py -- not committed.
scripts/ingestion/out/

# Local ingestion inputs — never committed. These hold scraped/imported club
# directory material, including a contacts CSV containing real club email
# addresses (PII). They are local input material, not product source.
# NOTE: data/clublogo/ is deliberately NOT ignored here -- 56 crest images
# are already tracked in the repository; ignoring the whole of data/ would
# hide that fact rather than change it.
data/clubcontacts/
data/clubdata/
data/fixturedata/
# data/clublogo/: local ingestion material, NOT a shipping asset -- no code in
# app/, lib/ or components/ reads this directory; the application serves club
# crests from Supabase Storage via clubs.logo_storage_path /
# club_directory.logo_storage_path (see lib/app-context/club-logo.ts). The 56
# crests already tracked in commit 9a00bed are deliberately left tracked
# (removing them would rewrite history for no functional gain); this rule stops
# further binary assets being added to the repository.
data/clublogo/

# Local tooling caches / local-only skill copies
.impeccable/
.claude/skills/
