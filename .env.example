# Supabase project connection details.
# Copy this file to .env.local and fill in real values — .env.local is gitignored.
#
# For local development, use the LOCAL stack's values (run `npx supabase
# start` then `npx supabase status`), not the remote/production project --
# NEXT_PUBLIC_SUPABASE_URL is http://127.0.0.1:54321 locally. Only point
# .env.local at the remote project deliberately, e.g. via a separate
# .env.production.local (also gitignored) that Next.js does not auto-load
# in `npm run dev`.
#
# Remote values come from: Supabase Dashboard > Project Settings > API (or
# `mcp__supabase__get_project_url` / `mcp__supabase__get_publishable_keys`
# when working with Claude Code).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# EMAIL
# ---------------------------------------------------------------------------
# Every one of these is SERVER-ONLY. None is NEXT_PUBLIC_*, so none is inlined
# into a browser bundle. Do not add a NEXT_PUBLIC_ prefix to any of them.
#
# Which sender to use. Unset means log-only: nothing leaves the machine, which
# is the deliberate default so running the app locally cannot mail real
# people. Production refuses to run log-only rather than silently discard mail.
#   (unset)   log-only  -- records the attempt, sends nothing
#   mailpit   local catcher (Supabase runs one on 54324)
#   zeptomail Zoho ZeptoMail REST Send API -- the production sender
EMAIL_PROVIDER=

# ZeptoMail "Send Mail" token, from the ZeptoMail console. May be supplied with
# or without its "Zoho-enczapikey " prefix. Required when EMAIL_PROVIDER=zeptomail.
ZEPTOMAIL_API_KEY=

# Only needed for a non-global ZeptoMail data centre (EU/IN). Defaults to
# https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_API_URL=

# The From address. No default is invented -- an unset value is reported as a
# configuration error rather than guessed at. Must be a domain verified in
# ZeptoMail, or the provider rejects the send.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# Where Site Admin due-diligence notifications (new club claims) are sent.
# A single named config value so the address lives in one place rather than
# hardcoded in application logic.
SITE_ADMIN_NOTIFICATION_EMAIL=

# UK address lookup (Club Management -> Directory -> "Look up address") --
# see lib/address-lookup/lookup.ts for the full integration and why
# getAddress.io was chosen. Not set locally, so lookups return
# "not_configured" rather than failing silently; the code is genuinely
# production-ready once a real key is added here. Covers England/Scotland/
# Wales/Northern Ireland only -- does NOT cover the Republic of Ireland
# (Eircodes), see that file's comment for why.
GETADDRESS_API_KEY=

# GoCardless Direct Debit Club Subscriptions (Side Project 1 integration) --
# see lib/payments/gocardless/env.ts for the full safety gate. Names only;
# no value is set here or in this repo's own .env.local. GOCARDLESS_ENV
# must stay "sandbox" (or unset) -- production is hard-disabled unless BOTH
# GOCARDLESS_ENV=production AND GOCARDLESS_PRODUCTION_GO_LIVE_CONFIRMED=true
# are deliberately set by a human, which this project has never done.
# Absolute origin of this deployment. REQUIRED IN PRODUCTION.
# Falls back to http://localhost:3000 when unset, which is correct for local
# development but must never reach production: it is the origin used to build
# the GoCardless OAuth redirect_uri. With GOCARDLESS_ENV=production the app
# refuses to build a redirect_uri unless this is a real HTTPS, non-localhost
# origin (see assertGoCardlessRedirectOriginSafe in lib/payments/gocardless/env.ts).
NEXT_PUBLIC_SITE_URL=

GOCARDLESS_CLIENT_ID=
GOCARDLESS_CLIENT_SECRET=
GOCARDLESS_WEBHOOK_SECRET=
GOCARDLESS_ENV=
GOCARDLESS_PRODUCTION_GO_LIVE_CONFIRMED=

# Ovalball's OWN GoCardless merchant -- Pipaxon collecting SUBSCRIPTIONS FROM
# RUGBY CLUBS. This is a different merchant and a different webhook endpoint
# (/api/platform-billing/webhooks) from the three variables above, which are
# the partner-app credentials Ovalball uses to connect to each CLUB's own
# merchant so that club can charge its own members. Sharing a credential
# between the two would let one domain move the other's money.
#
# Three gates must all be open before a penny is collected from a club:
#   1. GOCARDLESS_ENV / GOCARDLESS_PRODUCTION_GO_LIVE_CONFIRMED (shared)
#   2. OVALBALL_SAAS_BILLING_ENABLED=true (this domain's own switch)
#   3. both variables below actually set
# None of them is set here, in .env.local, or in any deployed environment.
# See lib/platform/gocardless/env.ts.
GOCARDLESS_PLATFORM_ACCESS_TOKEN=
GOCARDLESS_PLATFORM_WEBHOOK_SECRET=
OVALBALL_SAAS_BILLING_ENABLED=

# Server-only, RLS-bypassing key -- required by the GoCardless OAuth
# callback and webhook routes (lib/supabase/service-role.ts), which run
# with no authenticated user session. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Passwordless social sign-in (Google / Facebook / Apple)
# ---------------------------------------------------------------------------
# UI feature flags ONLY. Provider client IDs and secrets live in Supabase's
# own Auth provider configuration, never in this application -- nothing here
# is a secret. Each provider stays hidden until its own flag is "true", so
# activation is sequential: configure the provider console, enable it in
# Supabase, verify it, THEN flip the flag and redeploy. A button shown before
# its provider is configured sends a real person into a provider error page.
#
# Ovalball remains PASSWORDLESS. These are additional passwordless methods
# alongside the existing email magic link -- there is no password path.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=
NEXT_PUBLIC_AUTH_FACEBOOK_ENABLED=
NEXT_PUBLIC_AUTH_APPLE_ENABLED=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile — human verification on unauthenticated auth entry
# ---------------------------------------------------------------------------
# The rugby slider on /login and /signup is Ovalball UX; Turnstile is the
# actual anti-bot mechanism behind it (lib/auth/turnstile.ts). Pointer and
# touch events are automatable, so slider completion alone is never accepted
# as proof -- a token is verified server-side against Cloudflare.
#
# BOTH values must be set for verification to be enforced. With neither set,
# the checkpoint does not render and sign-in behaves exactly as it does
# today: deliberate, so a missing key cannot lock real users out of a
# working production service. Once set, it fails CLOSED.
#
# Get keys from: Cloudflare Dashboard > Turnstile > Add site.
# Cloudflare's public test keys, for local development only:
#   site   1x00000000000000000000AA   (always passes)
#   secret 1x0000000000000000000000000000000AA
# Note the test keys report hostname "example.com", which is why hostname
# binding is enforced in production only -- see lib/auth/turnstile.ts.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
