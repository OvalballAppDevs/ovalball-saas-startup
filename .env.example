# Supabase project connection details.
# Copy this file to .env.local and fill in real values — .env.local is gitignored.
# Get these from: Supabase Dashboard > Project Settings > API (or `mcp__supabase__get_project_url` /
# `mcp__supabase__get_publishable_keys` when working with Claude Code).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
