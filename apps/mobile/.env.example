# Ovalball mobile — development configuration.
#
# EVERY VALUE HERE IS COMPILED INTO THE APP BUNDLE AND IS THEREFORE PUBLIC.
# The publishable key is the Supabase anon key: it identifies the project and authorises nothing on its
# own, because every row it can reach is decided by RLS and by the capability engine on the server.
# A service-role key, a GoCardless secret, a ZeptoMail key or an invitation pepper must NEVER appear in
# this file or in any EXPO_PUBLIC_ variable. Treat the installed app as fully readable by an attacker.

EXPO_PUBLIC_OVALBALL_ENV=development

# A SIMULATOR can use localhost. A PHYSICAL PHONE cannot — it must reach your Mac over the LAN, so use
# the Mac's own address here (ipconfig getifaddr en0) and keep both devices on the same Wi-Fi.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where the app sends somebody for the jobs that are deliberately web-only.
EXPO_PUBLIC_OVALBALL_WEB_URL=http://localhost:3000
